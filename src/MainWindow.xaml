<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sarab Desktop" Width="1240" Height="860" MinWidth="1060" MinHeight="730" Background="{DynamicResource AppBg}" Foreground="{DynamicResource Text}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBg" Color="#151D22"/><SolidColorBrush x:Key="NavBg" Color="#DC10171B"/>
    <SolidColorBrush x:Key="CardSurface" Color="#F21D272D"/><SolidColorBrush x:Key="SurfaceAlt" Color="#DE263239"/><SolidColorBrush x:Key="Elevated" Color="#F5222E34"/>
    <SolidColorBrush x:Key="Border" Color="#39474E"/><SolidColorBrush x:Key="Text" Color="#EAF1ED"/><SolidColorBrush x:Key="MutedText" Color="#A6B4AE"/><SolidColorBrush x:Key="SoftText" Color="#C6D2CC"/>
    <SolidColorBrush x:Key="CardEdge" Color="#25FFFFFF"/><SolidColorBrush x:Key="NavHoverBorder" Color="#596A70"/><SolidColorBrush x:Key="NavActive" Color="#293C39"/>
    <SolidColorBrush x:Key="Input" Color="#141E23"/><SolidColorBrush x:Key="InputBorder" Color="#46565D"/><SolidColorBrush x:Key="Accent" Color="#68D5AB"/><SolidColorBrush x:Key="OnAccent" Color="#10221A"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#243831"/><SolidColorBrush x:Key="Selection" Color="#293C39"/><SolidColorBrush x:Key="ToggleOff" Color="#526168"/><SolidColorBrush x:Key="ToggleThumb" Color="#F1F5F2"/>
    <SolidColorBrush x:Key="Danger" Color="#F0A5AE"/><SolidColorBrush x:Key="DangerSoft" Color="#472B32"/><SolidColorBrush x:Key="Success" Color="#86D9B0"/><SolidColorBrush x:Key="Warning" Color="#EBC879"/><SolidColorBrush x:Key="Info" Color="#9AC9DC"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedText}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource CardEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="38"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource NavHoverBorder}"/><Setter TargetName="Surface" Property="Opacity" Value="0.92"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="8,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="NavSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11"/><Border x:Name="NavIndicator" Width="3" Margin="0,8,0,8" HorizontalAlignment="Left" Background="{DynamicResource Accent}" CornerRadius="2" Visibility="Collapsed"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource NavHoverBorder}"/><Setter TargetName="NavSurface" Property="Opacity" Value="0.92"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource AppBg}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource AppBg}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource AppBg}"/><Setter Property="MinHeight" Value="40"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="9"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Margin="12,8,32,8" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Elevated}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="10,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Selection}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Track" Background="{DynamicResource ToggleOff}" CornerRadius="12" Width="42" Height="24" Margin="0,0,12,0"><Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource ToggleThumb}" HorizontalAlignment="Left" Margin="3"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource OnAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="15"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ListSurface" Background="{DynamicResource SurfaceAlt}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ListSurface" Property="Background" Value="{DynamicResource Selection}"/><Setter TargetName="ListSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ListSurface" Property="BorderBrush" Value="{DynamicResource NavHoverBorder}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="RootSurface" Background="{DynamicResource AppBg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="76" MaxWidth="360"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="SidebarHost" Grid.Column="0" Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" ClipToBounds="True">
      <DockPanel LastChildFill="True">
        <StackPanel x:Name="SidebarBrand" DockPanel.Dock="Top" Margin="22,24,14,24"><Border x:Name="SidebarBrandMark" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" Width="46" Height="46" CornerRadius="15" HorizontalAlignment="Left"><TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource OnAccent}" FontSize="24" HorizontalAlignment="Center"/></Border><TextBlock x:Name="SidebarBrandName" Text="Sarab" FontSize="25" FontWeight="SemiBold" Margin="0,13,0,0"/><TextBlock x:Name="SidebarBrandCaption" Text="DESKTOP" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="1,3,0,0"/></StackPanel>
        <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="16,10,16,20"><Border x:Name="SidebarStatusCard" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" CornerRadius="13" Padding="12,10"><Grid x:Name="SidebarStatusGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="SidebarDot" Fill="{DynamicResource MutedText}" Width="8" Height="8" Margin="0,1,10,0" VerticalAlignment="Top"/><TextBlock x:Name="SidebarStatus" Grid.Column="1" Text="正在读取状态" FontSize="11" TextWrapping="Wrap"/></Grid></Border><TextBlock x:Name="SidebarVersion" Text="Sarab 1.0.0 · TheMRVX" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="3,11,0,0"/></StackPanel>
        <StackPanel x:Name="SidebarNavigation">
          <TextBlock x:Name="NavGroupLocation" Text="工作区" Foreground="{DynamicResource MutedText}" FontSize="10" FontWeight="SemiBold" Margin="22,2,12,7"/>
          <Button x:Name="NavDashboard" Style="{StaticResource Nav}" Tag="dashboard"><StackPanel Orientation="Horizontal"><TextBlock x:Name="NavDashboardIcon" Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,14,0"/><TextBlock x:Name="NavDashboardLabel" Text="概览"/></StackPanel></Button>
          <Button x:Name="NavSearch" Style="{StaticResource Nav}" Tag="search"><StackPanel Orientation="Horizontal"><TextBlock x:Name="NavSearchIcon" Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,14,0"/><TextBlock x:Name="NavSearchLabel" Text="地点搜索"/></StackPanel></Button>
          <Button x:Name="NavFavorites" Style="{StaticResource Nav}" Tag="favorites"><StackPanel Orientation="Horizontal"><TextBlock x:Name="NavFavoritesIcon" Text="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,14,0"/><TextBlock x:Name="NavFavoritesLabel" Text="位置收藏"/></StackPanel></Button>
          <Border x:Name="SidebarGroupSeparator" Height="1" Background="{DynamicResource Border}" Margin="20,13,20,10"/>
          <TextBlock x:Name="NavGroupSystem" Text="系统" Foreground="{DynamicResource MutedText}" FontSize="10" FontWeight="SemiBold" Margin="22,0,12,7"/>
          <Button x:Name="NavSetup" Style="{StaticResource Nav}" Tag="setup"><StackPanel Orientation="Horizontal"><TextBlock x:Name="NavSetupIcon" Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,14,0"/><TextBlock x:Name="NavSetupLabel" Text="安装与修复"/></StackPanel></Button>
          <Button x:Name="NavLogs" Style="{StaticResource Nav}" Tag="logs"><StackPanel Orientation="Horizontal"><TextBlock x:Name="NavLogsIcon" Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,14,0"/><TextBlock x:Name="NavLogsLabel" Text="操作记录"/></StackPanel></Button>
          <Button x:Name="NavSettings" Style="{StaticResource Nav}" Tag="settings"><StackPanel Orientation="Horizontal"><TextBlock x:Name="NavSettingsIcon" Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,14,0"/><TextBlock x:Name="NavSettingsLabel" Text="设置"/></StackPanel></Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" Focusable="True" IsTabStop="True" ToolTip="拖动调整侧栏宽度；聚焦后按左右方向键调整，Home / End 移至最窄 / 最宽。" ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext">
      <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border Background="Transparent"><Border x:Name="SplitterHandle" Width="1" Background="{DynamicResource Border}" HorizontalAlignment="Center" Margin="2,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SplitterHandle" Property="Width" Value="3"/><Setter TargetName="SplitterHandle" Property="Background" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SplitterHandle" Property="Width" Value="3"/><Setter TargetName="SplitterHandle" Property="Background" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></GridSplitter.Template>
    </GridSplitter>
    <Grid x:Name="MainContentHost" Grid.Column="2" Margin="32,22,32,20">
      <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0"><StackPanel><TextBlock x:Name="PageTitle" Text="位置控制台" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="让应用读取你设定的地点" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button x:Name="RefreshButton" Content="刷新状态" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" Padding="14,8"/></Grid>
      <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,8,0">
        <StackPanel>
          <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceAlt}" Padding="24,21"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Accent}" CornerRadius="18" Width="49" Height="49" VerticalAlignment="Top"><TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock x:Name="HeroStatus" Text="读取驱动状态中" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HeroCoordinates" Text="—" Foreground="{DynamicResource SoftText}" Margin="0,8,0,0" FontFamily="Consolas" FontSize="16"/><TextBlock x:Name="HeroDetail" Text="尚未读取 Windows 实际位置" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Button x:Name="VerifyButton" Grid.Column="2" Content="核验当前位置" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid></Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.38*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="目标位置" Style="{StaticResource SectionTitle}"/><TextBlock Text="位置名称" Style="{StaticResource Muted}"/><TextBox x:Name="NameInput" Margin="0,6,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="纬度 Latitude" Style="{StaticResource Muted}"/><TextBox x:Name="LatitudeInput" Margin="0,6,0,0" FontFamily="Consolas"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="经度 Longitude" Style="{StaticResource Muted}"/><TextBox x:Name="LongitudeInput" Margin="0,6,0,0" FontFamily="Consolas"/></StackPanel></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="海拔 / 米" Style="{StaticResource Muted}"/><TextBox x:Name="AltitudeInput" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="精度半径 / 米" Style="{StaticResource Muted}"/><TextBox x:Name="AccuracyInput" Margin="0,6,0,0"/></StackPanel></Grid><Expander Header="高级选项" Foreground="{DynamicResource MutedText}" Margin="0,18,0,0"><StackPanel Margin="0,8,0,0"><CheckBox x:Name="DriftToggle" Content="模拟自然漂移"/><TextBlock Text="漂移半径 / 米（0～50）" Style="{StaticResource Muted}" Margin="0,6,0,6"/><TextBox x:Name="DriftRadiusInput"/><TextBlock Text="固定虚拟地址时建议关闭漂移。" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="11"/></StackPanel></Expander><Button x:Name="ApplyButton" Content="应用并核验" Style="{StaticResource Primary}" Margin="0,22,0,10" MinHeight="43"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveFavoriteButton" Content="保存到收藏"/><Button x:Name="DisableButton" Grid.Column="2" Content="暂停虚拟定位" Foreground="{DynamicResource Danger}"/></Grid></StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="18,14"><TextBlock Text="关闭上位机后，虚拟定位继续由驱动提供。修改配置后请用“核验当前位置”确认系统实际结果。" Style="{StaticResource Muted}" FontSize="11"/></Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="系统实际读数" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ActualSource" Text="尚未核验" FontSize="18" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="ActualCoordinates" Text="点击核验，读取 Windows 实际位置" Style="{StaticResource Muted}" FontFamily="Consolas" Margin="0,10,0,0"/><TextBlock x:Name="ActualAccuracy" Text="报告精度  —" Style="{StaticResource Muted}" Margin="0,11,0,0"/><TextBlock x:Name="ActualDistance" Text="距驱动配置  —" Style="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock x:Name="ActualTime" Text="尚无采样记录" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,13,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="运行环境" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions><TextBlock Text="虚拟 GNSS 驱动" Style="{StaticResource Muted}"/><TextBlock x:Name="DriverStatusText" Grid.Column="1" Text="—"/><TextBlock Grid.Row="1" Text="Windows 定位权限" Style="{StaticResource Muted}"/><TextBlock x:Name="PermissionStatusText" Grid.Row="1" Grid.Column="1" Text="—"/><TextBlock Grid.Row="2" Text="测试签名" Style="{StaticResource Muted}"/><TextBlock x:Name="SigningStatusText" Grid.Row="2" Grid.Column="1" Text="—"/></Grid><Button x:Name="OpenLocationSettingsButton" Content="打开 Windows 定位设置" Margin="0,14,0,0" Padding="10,8"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="地图与地点" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBlock x:Name="MapCaption" Text="当前编辑位置" Style="{StaticResource Muted}" FontSize="11"/><Button x:Name="OpenMapButton" Content="在 Google Maps 查看 ↗" Margin="0,12,0,8"/><Button x:Name="GoSearchButton" Content="搜索地址 / 解析地图链接" Background="Transparent" Padding="6,7"/></StackPanel></Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="SearchPage" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="从地址或地图链接选取位置" Style="{StaticResource SectionTitle}"/><TextBox x:Name="SearchInput" ToolTip="地址、纬度,经度、度分秒或 Google Maps 链接" MinHeight="44"/><Grid Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="SearchProvider"><ComboBoxItem Content="OpenStreetMap · 免 Key"/><ComboBoxItem Content="Google Geocoding"/></ComboBox><Button x:Name="SearchButton" Grid.Column="2" Content="搜索 / 解析" Style="{StaticResource Primary}"/></Grid><TextBlock x:Name="SearchPrivacyText" Text="地址将发送至 OpenStreetMap / Nominatim。仅在点击搜索时查询；坐标可离线解析。" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><ListBox x:Name="SearchResults" Grid.Row="1" Margin="0,0,0,12"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,7,0,0" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2"><TextBlock x:Name="SearchHint" Text="可直接粘贴：51.5074,-0.1278；也支持度分秒或地图链接" Style="{StaticResource Muted}" Margin="0,0,0,12"/><Button x:Name="UseSearchResultButton" Content="将所选地点载入编辑" IsEnabled="False" Style="{StaticResource Primary}" HorizontalAlignment="Left"/><TextBlock x:Name="SearchAttribution" Text="© OpenStreetMap contributors · Nominatim" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,14,0,4"/></StackPanel></Grid>
      <Grid x:Name="FavoritesPage" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,20"><TextBlock Text="收藏地点可载入编辑，也可直接应用并核验。" Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ImportFavoritesButton" Content="导入" Margin="0,0,8,0"/><Button x:Name="ExportFavoritesButton" Content="导出"/></StackPanel></Grid><ListBox x:Name="FavoritesList" Grid.Row="1"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Coordinates}" FontFamily="Consolas" Foreground="{DynamicResource SoftText}" Margin="0,8,0,0"/><TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="FavoritesEmptyHint" Grid.Row="1" Panel.ZIndex="1" Text="还没有收藏位置。可在概览页点击“保存到收藏”。" Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" IsHitTestVisible="False"/><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0"><Button x:Name="LoadFavoriteButton" Content="载入编辑" Margin="0,0,10,0"/><Button x:Name="ApplyFavoriteButton" Content="应用此位置" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button x:Name="DeleteFavoriteButton" Content="移除收藏" Foreground="{DynamicResource Danger}"/><Button x:Name="UndoFavoriteButton" Content="撤销移除" Margin="10,0,0,0" Visibility="Collapsed"/></StackPanel></Grid>
      <Grid x:Name="LogsPage" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button x:Name="CopyLogsButton" Content="复制记录" Margin="0,0,10,0"/><Button x:Name="OpenDataFolderButton" Content="打开数据目录"/></StackPanel><TextBox x:Name="LogsText" Grid.Row="1" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Padding="18"/></Grid>
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,10,8,0"><StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock x:Name="AppearanceHeading" Text="外观与语言" Style="{StaticResource SectionTitle}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="界面语言" Style="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="LanguageSelector"><ComboBoxItem Tag="auto" Content="自动（跟随系统）"/><ComboBoxItem Tag="zh-CN" Content="简体中文"/><ComboBoxItem Tag="zh-TW" Content="繁體中文"/><ComboBoxItem Tag="ja-JP" Content="日本語"/><ComboBoxItem Tag="en-US" Content="English"/><ComboBox.ToolTip>更改语言会立即更新所有窗口控件与托盘菜单。</ComboBox.ToolTip></ComboBox><TextBlock Text="自动模式会跟随 Windows 首选显示语言。" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="颜色主题" Style="{StaticResource Muted}" Margin="0,0,0,7"/><CheckBox x:Name="SystemThemeToggle" Content="跟随 Windows 外观"/><CheckBox x:Name="NightModeToggle" Content="夜间模式"/><TextBlock Text="系统模式会随 Windows 日间 / 夜间外观同步。" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock Text="强调色" Style="{StaticResource Muted}" Margin="0,0,0,7"/><ComboBox x:Name="AccentSelector"><ComboBoxItem Tag="mint"><StackPanel Orientation="Horizontal"><Ellipse Fill="#68D5AB" Width="12" Height="12" Margin="0,0,9,0"/><TextBlock Text="薄荷绿"/></StackPanel></ComboBoxItem><ComboBoxItem Tag="ocean"><StackPanel Orientation="Horizontal"><Ellipse Fill="#72BFE6" Width="12" Height="12" Margin="0,0,9,0"/><TextBlock Text="海洋蓝"/></StackPanel></ComboBoxItem><ComboBoxItem Tag="violet"><StackPanel Orientation="Horizontal"><Ellipse Fill="#B5A0F4" Width="12" Height="12" Margin="0,0,9,0"/><TextBlock Text="鸢尾紫"/></StackPanel></ComboBoxItem><ComboBoxItem Tag="amber"><StackPanel Orientation="Horizontal"><Ellipse Fill="#F0BB62" Width="12" Height="12" Margin="0,0,9,0"/><TextBlock Text="琥珀金"/></StackPanel></ComboBoxItem></ComboBox></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,20,0,0"><Grid><TextBlock Text="界面字号" Style="{StaticResource Muted}"/><TextBlock x:Name="FontScaleValue" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Text="100%"/><Button x:Name="ResetFontScaleButton" Content="恢复默认" HorizontalAlignment="Right" Padding="8,4" MinHeight="26" Margin="0,-3,58,0"/></Grid><Slider x:Name="FontScaleSlider" Minimum="90" Maximum="125" Value="100" TickFrequency="5" SmallChange="5" IsSnapToTickEnabled="True" Margin="0,10,0,0"/><TextBlock Text="立即生效并保存；你的地点名称和历史记录保持原样。" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
          </Grid>
        </StackPanel></Border>

        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="启动与后台" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="StartupToggle" Content="登录 Windows 后自动启动到托盘"/><CheckBox x:Name="CloseToTrayToggle" Content="关闭窗口时最小化到托盘"/><CheckBox x:Name="VerifyStartupToggle" Content="启动时核验系统实际位置"/><CheckBox x:Name="VerifyApplyToggle" Content="应用位置后自动核验"/><TextBlock Text="开机启动仅启动上位机，不改写当前坐标。退出程序会保留虚拟定位；托盘菜单可重新打开窗口。" Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="地址搜索服务" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="SettingsProvider" MaxWidth="330" HorizontalAlignment="Left"><ComboBoxItem Content="OpenStreetMap · 免 Key"/><ComboBoxItem Content="Google Geocoding"/></ComboBox><TextBlock Text="Google 地址查询需要启用 Geocoding API 的 Key 与账单账户。Google Maps 链接解析和打开地图无需 Key。" Style="{StaticResource Muted}" Margin="0,13,0,14"/><TextBlock Text="Google Geocoding API Key" Style="{StaticResource Muted}"/><PasswordBox x:Name="GoogleKeyInput" Margin="0,7,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="GoogleKeyStatus" Text="未配置 · Key 仅在当前 Windows 用户下加密保存" Style="{StaticResource Muted}" FontSize="11"/><Button x:Name="ClearGoogleKeyButton" Grid.Column="1" Content="清除已保存 Key" Padding="12,7" Margin="10,0,0,0"/></Grid><TextBlock Text="不会把 Key 写入操作记录或收藏导出文件。搜索失败时不会静默切换服务。" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
        <Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource Primary}" HorizontalAlignment="Left" MinWidth="140" Margin="0,0,0,18"/>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Sarab Desktop 1.1" FontWeight="SemiBold"/><TextBlock Text="由 TheMRVX 的 Sarab 驱动与 CLI 提供定位能力。本项目只新增独立桌面 GUI、语言支持与安装引导，并非上游官方版本。公网 IP 仍由 VPN 决定。" Style="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/><TextBlock Text="上游 Sarab v1.0.0 © 2026 TheMRVX · MIT 许可。GUI 导航组织参考 Clash Verge，界面与图标独立实现。" Style="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/><Button x:Name="OpenUpstreamButton" Content="打开 Sarab 原项目 ↗" Margin="0,14,0,8"/><Button x:Name="OpenCreditsButton" Content="查看贡献与许可"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <ScrollViewer x:Name="SetupPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,10,8,0"><StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="1 · 检查系统条件" Style="{StaticResource SectionTitle}"/><TextBlock Text="驱动与定位核心由 TheMRVX 提供。此向导安装固定的原版 Sarab v1.0.0，不会静默更改固件、加密或位置权限。" Style="{StaticResource Muted}" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Windows 与架构" Margin="0,8"/><TextBlock x:Name="SetupOsText" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/><TextBlock Text="Secure Boot" Grid.Row="1" Margin="0,8"/><TextBlock x:Name="SetupBootText" Grid.Row="1" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/><TextBlock Text="测试签名" Grid.Row="2" Margin="0,8"/><TextBlock x:Name="SetupSigningText" Grid.Row="2" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/><TextBlock Text="Sarab 驱动" Grid.Row="3" Margin="0,8"/><TextBlock x:Name="SetupDriverText" Grid.Row="3" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/><TextBlock Text="Windows 位置权限" Grid.Row="4" Margin="0,8"/><TextBlock x:Name="SetupPermissionText" Grid.Row="4" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/><TextBlock Text="内存完整性 (HVCI)" Grid.Row="5" Margin="0,8"/><TextBlock x:Name="SetupMemoryIntegrityText" Grid.Row="5" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/></Grid><TextBlock Text="内存完整性可能影响测试驱动运行；此处仅作诊断，不会自动关闭。修改启动配置前，辅助程序会检查系统盘保护；保护未暂停或状态未知时会停止。" Style="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0"/><Button x:Name="OpenInstallGuideButton" Content="打开安装与恢复指南" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="2 · 准备测试模式并手动重启" Style="{StaticResource SectionTitle}"/><TextBlock Text="原版驱动使用测试签名。Secure Boot 开启时，需要自行按厂商说明调整 UEFI；程序不会自动关闭它。开启测试模式会放宽驱动签名限制，且重启后才生效。" Style="{StaticResource Muted}"/><Button x:Name="PrepareSystemButton" Content="检查并准备 Windows" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="3 · 安装驱动并允许定位" Style="{StaticResource SectionTitle}"/><TextBlock Text="安装会导入上游测试证书并注册虚拟 GNSS 设备，随后检查设备健康状态。新安装默认暂停虚拟定位，请先填写自己的目标坐标。Windows 定位权限需要你手动允许。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,16,0,0"><Button x:Name="InstallDriverButton" Content="安装 / 修复原版驱动" Style="{StaticResource Primary}" Margin="0,0,10,10"/><Button x:Name="SetupLocationButton" Content="打开 Windows 定位设置" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="卸载驱动" Style="{StaticResource SectionTitle}"/><TextBlock Text="卸载上位机不会自动移除驱动。此处可以单独移除 Sarab 设备和对应驱动包；之后系统可能恢复真实位置来源。全局测试模式和共享证书保留，清理方法见指南。" Style="{StaticResource Muted}"/><Button x:Name="RemoveDriverButton" Content="卸载 Sarab 驱动" Foreground="{DynamicResource Danger}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Border x:Name="NoticeBar" Grid.Row="2" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" CornerRadius="14" Padding="14,8" Margin="0,10,0,0" Visibility="Collapsed" Focusable="True" KeyboardNavigation.TabIndex="0" Cursor="Hand" AutomationProperties.Name="拒绝访问" AutomationProperties.HelpText="双击查看完整喜报。">
        <Grid>
          <StackPanel x:Name="NoticeStandardPanel" Visibility="Visible"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12"/></StackPanel>
          <Grid x:Name="NoticeAwardPanel" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource DangerSoft}" BorderBrush="#C9A64A" BorderThickness="1" CornerRadius="10" Padding="7,2" VerticalAlignment="Center"><TextBlock x:Name="NoticeAwardLabel" Text="喜报" Foreground="{DynamicResource Warning}" FontWeight="Bold" FontSize="11"/></Border>
              <TextBlock x:Name="NoticeOpenHint" Grid.Column="2" Text="双击查看完整喜报" Foreground="{DynamicResource MutedText}" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="NoticeHeadline" Grid.Row="1" Text="拒绝访问" TextAlignment="Center" HorizontalAlignment="Stretch" FontSize="25" FontWeight="Bold" Margin="0,1,0,0"/>
            <TextBlock x:Name="NoticeAwardTeaser" Grid.Row="2" Text="Windows 拒绝了本次操作…" TextAlignment="Center" Foreground="{DynamicResource SoftText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,1"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
