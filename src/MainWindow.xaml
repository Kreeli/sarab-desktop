<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sarab Desktop" Width="1200" Height="850" MinWidth="1050" MinHeight="730" Background="#191923" Foreground="#EFEEF8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#BDB0FF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EFEEF8"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#A5A2B8"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#22222F"/><Setter Property="BorderBrush" Value="#343341"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EEEAF9"/><Setter Property="Background" Value="#363344"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="38"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#BDB0FF"/><Setter Property="Foreground" Value="#231C38"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="10,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F0EDF8"/><Setter Property="Background" Value="#191923"/><Setter Property="BorderBrush" Value="#464355"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="CaretBrush" Value="#C6B9FF"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#BDB0FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="#F0EDF8"/><Setter Property="Background" Value="#191923"/><Setter Property="BorderBrush" Value="#464355"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F0EDF8"/><Setter Property="Background" Value="#191923"/><Setter Property="MinHeight" Value="40"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#191923" BorderBrush="#464355" BorderThickness="1" CornerRadius="9"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Margin="12,8,32,8" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#2C293B" BorderBrush="#625979" BorderThickness="1" CornerRadius="9" Padding="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EFEEF8"/><Setter Property="Padding" Value="10,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#4C4265"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EFEEF8"/><Setter Property="Margin" Value="0,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Track" Background="#514C62" CornerRadius="12" Width="42" Height="24" Margin="0,0,12,0"><Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#E9E3F7" HorizontalAlignment="Left" Margin="3"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#AB99E5"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="#2D2342"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#EFEEF8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="15"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ListSurface" Background="#262432" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ListSurface" Property="Background" Value="#42385C"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ListSurface" Property="BorderBrush" Value="#726087"/><Setter TargetName="ListSurface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid x:Name="RootSurface" Background="#191923">
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#13131D" BorderBrush="#2C2A3A" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="24,26,12,28"><Border Background="#BDB0FF" Width="45" Height="45" CornerRadius="15" HorizontalAlignment="Left"><TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons" Foreground="#251D3B" FontSize="24" HorizontalAlignment="Center"/></Border><TextBlock Text="Sarab" FontSize="25" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock Text="DESKTOP" Foreground="#A5A2B8" FontSize="10" Margin="1,3,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="24,10,18,24"><Border Background="#242331" CornerRadius="10" Padding="10,9"><StackPanel Orientation="Horizontal"><Ellipse x:Name="SidebarDot" Fill="#827D93" Width="7" Height="7" Margin="0,0,8,0"/><TextBlock x:Name="SidebarStatus" Text="正在读取状态" FontSize="11"/></StackPanel></Border><TextBlock Text="Sarab 1.0.0 · TheMRVX" Foreground="#747186" FontSize="11" Margin="1,12,0,0"/></StackPanel>
        <StackPanel>
          <Button x:Name="NavDashboard" Style="{StaticResource Nav}" Tag="dashboard"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,16,0"/><TextBlock Text="概览"/></StackPanel></Button>
          <Button x:Name="NavSearch" Style="{StaticResource Nav}" Tag="search"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,16,0"/><TextBlock Text="地点搜索"/></StackPanel></Button>
          <Button x:Name="NavFavorites" Style="{StaticResource Nav}" Tag="favorites"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,16,0"/><TextBlock Text="位置收藏"/></StackPanel></Button>
          <Button x:Name="NavLogs" Style="{StaticResource Nav}" Tag="logs"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,16,0"/><TextBlock Text="操作记录"/></StackPanel></Button>
          <Button x:Name="NavSetup" Style="{StaticResource Nav}" Tag="setup"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,16,0"/><TextBlock Text="安装与修复"/></StackPanel></Button>
          <Button x:Name="NavSettings" Style="{StaticResource Nav}" Tag="settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,16,0"/><TextBlock Text="设置"/></StackPanel></Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,22,30,18">
      <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0"><StackPanel><TextBlock x:Name="PageTitle" Text="位置控制台" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="让应用读取你设定的地点" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button x:Name="RefreshButton" Content="刷新状态" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" Padding="14,8"/></Grid>
      <ScrollViewer x:Name="DashboardPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,8,0">
        <StackPanel>
          <Border Style="{StaticResource Card}" Background="#2C273D" Padding="24,21"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#BDB0FF" CornerRadius="18" Width="49" Height="49" VerticalAlignment="Top"><TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="#2E2346" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock x:Name="HeroStatus" Text="读取驱动状态中" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HeroCoordinates" Text="—" Foreground="#D7D0E8" Margin="0,8,0,0" FontFamily="Consolas" FontSize="16"/><TextBlock x:Name="HeroDetail" Text="尚未读取 Windows 实际位置" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Button x:Name="VerifyButton" Grid.Column="2" Content="核验当前位置" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid></Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.38*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="目标位置" Style="{StaticResource SectionTitle}"/><TextBlock Text="位置名称" Style="{StaticResource Muted}"/><TextBox x:Name="NameInput" Margin="0,6,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="纬度 Latitude" Style="{StaticResource Muted}"/><TextBox x:Name="LatitudeInput" Margin="0,6,0,0" FontFamily="Consolas"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="经度 Longitude" Style="{StaticResource Muted}"/><TextBox x:Name="LongitudeInput" Margin="0,6,0,0" FontFamily="Consolas"/></StackPanel></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="海拔 / 米" Style="{StaticResource Muted}"/><TextBox x:Name="AltitudeInput" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="精度半径 / 米" Style="{StaticResource Muted}"/><TextBox x:Name="AccuracyInput" Margin="0,6,0,0"/></StackPanel></Grid><Expander Header="高级选项" Foreground="#B9B2CB" Margin="0,18,0,0"><StackPanel Margin="0,8,0,0"><CheckBox x:Name="DriftToggle" Content="模拟自然漂移"/><TextBlock Text="漂移半径 / 米（0～50）" Style="{StaticResource Muted}" Margin="0,6,0,6"/><TextBox x:Name="DriftRadiusInput"/><TextBlock Text="固定虚拟地址时建议关闭漂移。" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="11"/></StackPanel></Expander><Button x:Name="ApplyButton" Content="应用并核验" Style="{StaticResource Primary}" Margin="0,22,0,10" MinHeight="43"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveFavoriteButton" Content="保存到收藏"/><Button x:Name="DisableButton" Grid.Column="2" Content="暂停虚拟定位" Foreground="#F0B7BD"/></Grid></StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="18,14"><TextBlock Text="关闭上位机后，虚拟定位继续由驱动提供。修改配置后请用“核验当前位置”确认系统实际结果。" Style="{StaticResource Muted}" FontSize="11"/></Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="系统实际读数" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ActualSource" Text="尚未核验" FontSize="18" Foreground="#C5B5F3"/><TextBlock x:Name="ActualCoordinates" Text="点击核验，读取 Windows 实际位置" Style="{StaticResource Muted}" FontFamily="Consolas" Margin="0,10,0,0"/><TextBlock x:Name="ActualAccuracy" Text="报告精度  —" Style="{StaticResource Muted}" Margin="0,11,0,0"/><TextBlock x:Name="ActualDistance" Text="距驱动配置  —" Style="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock x:Name="ActualTime" Text="尚无采样记录" Foreground="#7F7A92" FontSize="11" Margin="0,13,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="运行环境" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions><TextBlock Text="虚拟 GNSS 驱动" Style="{StaticResource Muted}"/><TextBlock x:Name="DriverStatusText" Grid.Column="1" Text="—"/><TextBlock Grid.Row="1" Text="Windows 定位权限" Style="{StaticResource Muted}"/><TextBlock x:Name="PermissionStatusText" Grid.Row="1" Grid.Column="1" Text="—"/><TextBlock Grid.Row="2" Text="测试签名" Style="{StaticResource Muted}"/><TextBlock x:Name="SigningStatusText" Grid.Row="2" Grid.Column="1" Text="—"/></Grid><Button x:Name="OpenLocationSettingsButton" Content="打开 Windows 定位设置" Margin="0,14,0,0" Padding="10,8"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="地图与地点" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBlock x:Name="MapCaption" Text="当前编辑位置" Style="{StaticResource Muted}" FontSize="11"/><Button x:Name="OpenMapButton" Content="在 Google Maps 查看 ↗" Margin="0,12,0,8"/><Button x:Name="GoSearchButton" Content="搜索地址 / 解析地图链接" Background="Transparent" Padding="6,7"/></StackPanel></Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="SearchPage" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="从地址或地图链接选取位置" Style="{StaticResource SectionTitle}"/><TextBox x:Name="SearchInput" ToolTip="地址、纬度,经度、度分秒或 Google Maps 链接" MinHeight="44"/><Grid Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="SearchProvider"><ComboBoxItem Content="OpenStreetMap · 免 Key"/><ComboBoxItem Content="Google Geocoding"/></ComboBox><Button x:Name="SearchButton" Grid.Column="2" Content="搜索 / 解析" Style="{StaticResource Primary}"/></Grid><TextBlock x:Name="SearchPrivacyText" Text="地址将发送至 OpenStreetMap / Nominatim。仅在点击搜索时查询；坐标可离线解析。" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><ListBox x:Name="SearchResults" Grid.Row="1" Margin="0,0,0,12"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,7,0,0" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2"><TextBlock x:Name="SearchHint" Text="可直接粘贴：51.5074,-0.1278；也支持度分秒或地图链接" Style="{StaticResource Muted}" Margin="0,0,0,12"/><Button x:Name="UseSearchResultButton" Content="将所选地点载入编辑" IsEnabled="False" Style="{StaticResource Primary}" HorizontalAlignment="Left"/><TextBlock x:Name="SearchAttribution" Text="© OpenStreetMap contributors · Nominatim" Foreground="#827D93" FontSize="11" Margin="0,14,0,4"/></StackPanel></Grid>
      <Grid x:Name="FavoritesPage" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,20"><TextBlock Text="收藏地点可载入编辑，也可直接应用并核验。" Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ImportFavoritesButton" Content="导入" Margin="0,0,8,0"/><Button x:Name="ExportFavoritesButton" Content="导出"/></StackPanel></Grid><ListBox x:Name="FavoritesList" Grid.Row="1"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Coordinates}" FontFamily="Consolas" Foreground="#C9BDE1" Margin="0,8,0,0"/><TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0"><Button x:Name="LoadFavoriteButton" Content="载入编辑" Margin="0,0,10,0"/><Button x:Name="ApplyFavoriteButton" Content="应用此位置" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button x:Name="DeleteFavoriteButton" Content="移除收藏" Foreground="#F0B7BD"/><Button x:Name="UndoFavoriteButton" Content="撤销移除" Margin="10,0,0,0" Visibility="Collapsed"/></StackPanel></Grid>
      <Grid x:Name="LogsPage" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button x:Name="CopyLogsButton" Content="复制记录" Margin="0,0,10,0"/><Button x:Name="OpenDataFolderButton" Content="打开数据目录"/></StackPanel><TextBox x:Name="LogsText" Grid.Row="1" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Padding="18"/></Grid>
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,10,8,0"><StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="界面语言" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="LanguageSelector" Width="250" HorizontalAlignment="Left"><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="English"/></ComboBox><TextBlock Text="切换立即生效并自动保存，不翻译你自己的地点名称或历史日志。" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>

        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="启动与后台" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="StartupToggle" Content="登录 Windows 后自动启动到托盘"/><CheckBox x:Name="CloseToTrayToggle" Content="关闭窗口时最小化到托盘"/><CheckBox x:Name="VerifyStartupToggle" Content="启动时核验系统实际位置"/><CheckBox x:Name="VerifyApplyToggle" Content="应用位置后自动核验"/><TextBlock Text="开机启动仅启动上位机，不改写当前坐标。退出程序会保留虚拟定位；托盘菜单可重新打开窗口。" Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="地址搜索服务" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="SettingsProvider" MaxWidth="330" HorizontalAlignment="Left"><ComboBoxItem Content="OpenStreetMap · 免 Key"/><ComboBoxItem Content="Google Geocoding"/></ComboBox><TextBlock Text="Google 地址查询需要启用 Geocoding API 的 Key 与账单账户。Google Maps 链接解析和打开地图无需 Key。" Style="{StaticResource Muted}" Margin="0,13,0,14"/><TextBlock Text="Google Geocoding API Key" Style="{StaticResource Muted}"/><PasswordBox x:Name="GoogleKeyInput" Margin="0,7,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="GoogleKeyStatus" Text="未配置 · Key 仅在当前 Windows 用户下加密保存" Style="{StaticResource Muted}" FontSize="11"/><Button x:Name="ClearGoogleKeyButton" Grid.Column="1" Content="清除已保存 Key" Padding="12,7" Margin="10,0,0,0"/></Grid><TextBlock Text="不会把 Key 写入操作记录或收藏导出文件。搜索失败时不会静默切换服务。" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
        <Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource Primary}" HorizontalAlignment="Left" MinWidth="140" Margin="0,0,0,18"/>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Sarab Desktop 1.1" FontWeight="SemiBold"/><TextBlock Text="由 TheMRVX 的 Sarab 驱动与 CLI 提供定位能力。本项目只新增独立桌面 GUI、语言支持与安装引导，并非上游官方版本。公网 IP 仍由 VPN 决定。" Style="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/><TextBlock Text="上游 Sarab v1.0.0 © 2026 TheMRVX · MIT 许可。GUI 视觉参考 FlClash，界面与图标独立实现。" Style="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/><Button x:Name="OpenUpstreamButton" Content="打开 Sarab 原项目 ↗" Margin="0,14,0,8"/><Button x:Name="OpenCreditsButton" Content="查看贡献与许可"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <ScrollViewer x:Name="SetupPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,10,8,0"><StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="1 · 检查系统条件" Style="{StaticResource SectionTitle}"/><TextBlock Text="驱动与定位核心由 TheMRVX 提供。此向导安装固定的原版 Sarab v1.0.0，不会静默更改固件、加密或位置权限。" Style="{StaticResource Muted}" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Windows 与架构" Margin="0,8"/><TextBlock x:Name="SetupOsText" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/><TextBlock Text="Secure Boot" Grid.Row="1" Margin="0,8"/><TextBlock x:Name="SetupBootText" Grid.Row="1" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/><TextBlock Text="测试签名" Grid.Row="2" Margin="0,8"/><TextBlock x:Name="SetupSigningText" Grid.Row="2" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/><TextBlock Text="Sarab 驱动" Grid.Row="3" Margin="0,8"/><TextBlock x:Name="SetupDriverText" Grid.Row="3" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/><TextBlock Text="Windows 位置权限" Grid.Row="4" Margin="0,8"/><TextBlock x:Name="SetupPermissionText" Grid.Row="4" Grid.Column="1" Text="等待检测" TextWrapping="Wrap"/></Grid><TextBlock Text="修改启动配置前，辅助程序会以管理员身份检查系统盘保护。保护未暂停或状态未知时会停止，详情见安装指南。" Style="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0"/><Button x:Name="OpenInstallGuideButton" Content="打开安装与恢复指南" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="2 · 准备测试模式并手动重启" Style="{StaticResource SectionTitle}"/><TextBlock Text="原版驱动使用测试签名。Secure Boot 开启时，需要自行按厂商说明调整 UEFI；程序不会自动关闭它。开启测试模式会放宽驱动签名限制，且重启后才生效。" Style="{StaticResource Muted}"/><Button x:Name="PrepareSystemButton" Content="检查并准备 Windows" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="3 · 安装驱动并允许定位" Style="{StaticResource SectionTitle}"/><TextBlock Text="安装会导入上游测试证书并注册虚拟 GNSS 设备，随后检查设备健康状态。新安装默认暂停虚拟定位，请先填写自己的目标坐标。Windows 定位权限需要你手动允许。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,16,0,0"><Button x:Name="InstallDriverButton" Content="安装 / 修复原版驱动" Style="{StaticResource Primary}" Margin="0,0,10,10"/><Button x:Name="SetupLocationButton" Content="打开 Windows 定位设置" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="卸载驱动" Style="{StaticResource SectionTitle}"/><TextBlock Text="卸载上位机不会自动移除驱动。此处可以单独移除 Sarab 设备和对应驱动包；之后系统可能恢复真实位置来源。全局测试模式和共享证书保留，清理方法见指南。" Style="{StaticResource Muted}"/><Button x:Name="RemoveDriverButton" Content="卸载 Sarab 驱动" Foreground="#F0B7BD" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Border x:Name="NoticeBar" Grid.Row="2" Background="#302A42" CornerRadius="10" Padding="14,10" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12"/></Border>
    </Grid>
  </Grid>
</Window>
